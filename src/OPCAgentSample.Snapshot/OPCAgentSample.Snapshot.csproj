<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Werkzeug, das die Momentaufnahme der Demo (Vorschau-Daten der Oberfläche) erzeugt:
      dotnet run, Projekt src/OPCAgentSample.Snapshot (Zielordner: src/OPCAgentSample.Web/public/snapshot)
    Es liegt bewusst außerhalb des Servers: Der Server kennt weder Simulator noch Simulation, nur den Vertrag IHistorySource.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Relative Pfade der Kommandozeile gelten ab dem Ordner des Aufrufers, nicht ab dem Projektordner. -->
    <RunWorkingDirectory>$(MSBuildStartupDirectory)</RunWorkingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OPCAgentSample.Server\OPCAgentSample.Server.csproj" />
    <ProjectReference Include="..\OPCAgentSample.Simulation\OPCAgentSample.Simulation.csproj" />
  </ItemGroup>

</Project>
